<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EasyShop.Views.SalesPage"
             Title="Vendas"
             BackgroundColor="#F4F6F9">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <Label Text="Nova Venda"
                   FontSize="26"
                   FontAttributes="Bold"
                   TextColor="#183153" />

            <Border BackgroundColor="White"
                    Stroke="#DCE3EB"
                    Padding="16"
                    StrokeShape="RoundRectangle 14">

                <VerticalStackLayout Spacing="12">

                    <Label Text="Selecionar cliente"
                           FontAttributes="Bold"
                           TextColor="#183153" />

                    <Picker x:Name="CustomerPicker"
                            Title="Escolha um cliente"
                            ItemDisplayBinding="{Binding Name}" />

                    <Label Text="Selecionar produto"
                           FontAttributes="Bold"
                           TextColor="#183153" />

                    <Picker x:Name="ProductPicker"
                            Title="Escolha um produto"
                            ItemDisplayBinding="{Binding Name}" />

                    <Entry x:Name="QuantityEntry"
                           Placeholder="Quantidade"
                           Keyboard="Numeric" />

                    <Button Text="Adicionar produto"
                            BackgroundColor="#2463EB"
                            TextColor="White"
                            CornerRadius="10"
                            HeightRequest="48"
                            Clicked="OnAddProductClicked" />

                </VerticalStackLayout>
            </Border>

            <Label Text="Itens da venda"
                   FontSize="21"
                   FontAttributes="Bold"
                   TextColor="#183153" />

            <VerticalStackLayout x:Name="SaleItemsList"
                                 Spacing="10" />

            <Label x:Name="TotalLabel"
                   Text="Total: R$ 0,00"
                   FontSize="22"
                   FontAttributes="Bold"
                   TextColor="#16865B"
                   HorizontalOptions="End" />

            <Button Text="Finalizar venda"
                    BackgroundColor="#16865B"
                    TextColor="White"
                    CornerRadius="10"
                    HeightRequest="52"
                    Clicked="OnFinishSaleClicked" />

            <Button Text="Atualizar dados"
                    BackgroundColor="#E8EEF8"
                    TextColor="#183153"
                    CornerRadius="10"
                    HeightRequest="44"
                    Clicked="OnRefreshClicked" />

            <Label Text="Histórico de vendas"
                   FontSize="21"
                   FontAttributes="Bold"
                   TextColor="#183153" />

            <VerticalStackLayout x:Name="SalesHistoryList"
                                 Spacing="10" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>